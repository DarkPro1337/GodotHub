<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GodotHub.Desktop.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="https://github.com/projektanker/icons.avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="GodotHub.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/GodotHub.ico"
    Title="GodotHub"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    TransparencyLevelHint="AcrylicBlur"
    Width="690" Height="580">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.25" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid x:Name="MainGrid" RowDefinitions="Auto, *, Auto">
            <DockPanel Margin="4" VerticalAlignment="Top" Height="36">
                <Button
                    Height="32"
                    Command="{Binding AddInstanceCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    ToolTip.Tip="Add a new instance of Godot Engine.">
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <i:Icon DockPanel.Dock="Left" FontSize="20" Value="mdi-plus-box" Margin="0 0 4 0" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="Add Instance" />
                    </DockPanel>
                </Button>
                <Separator Width="1" Height="32" Margin="4 0" />
                <DropDownButton>
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <i:Icon DockPanel.Dock="Left" FontSize="20" Value="mdi-folder-open" Margin="0 0 4 0" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="Folders" />
                    </DockPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem
                                Header="View Instances Folder"
                                Command="{Binding ViewInstancesFolderCommand}">
                                <MenuItem.Icon>
                                    <i:Icon FontSize="20" Value="mdi-folder" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="View Launcher Root Folder"
                                Command="{Binding ViewLauncherRootFolderCommand}">
                                <MenuItem.Icon>
                                    <i:Icon FontSize="20" Value="mdi-folder" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button
                    Height="32"
                    Margin="4 0"
                    Command="{Binding OpenSettingsCommand}"
                    CommandParameter="{Binding $parent[Window]}">
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <i:Icon DockPanel.Dock="Left" FontSize="20" Value="mdi-cog" Margin="0 0 4 0" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="Settings" />
                    </DockPanel>
                </Button>

                <DropDownButton>
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <i:Icon DockPanel.Dock="Left" FontSize="20" Value="mdi-help-circle" Margin="0 0 4 0" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="Help" />
                    </DockPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem
                                Header="Clear Cache"
                                Command="{Binding ClearCacheCommand}">
                                <MenuItem.Icon>
                                    <i:Icon FontSize="20" Value="mdi-broom" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="Report a Bug"
                                Command="{Binding ReportBugCommand}">
                                <MenuItem.Icon>
                                    <i:Icon FontSize="20" Value="mdi-bug" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="About GodotHub"
                                Command="{Binding OpenAboutCommand}">
                                <MenuItem.Icon>
                                    <i:Icon FontSize="20" Value="mdi-information" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </DockPanel>
            <!-- <ScrollViewer Grid.Row="1"> -->
            <!--     <ItemsControl ItemsSource="{Binding Instances}"> -->
            <!--         <ItemsControl.ItemsPanel> -->
            <!--             <ItemsPanelTemplate> -->
            <!--                 <WrapPanel HorizontalAlignment="Stretch" /> -->
            <!--             </ItemsPanelTemplate> -->
            <!--         </ItemsControl.ItemsPanel> -->
            <!--         <ItemsControl.ItemTemplate> -->
            <!--             <DataTemplate DataType="{x:Type vm:InstanceViewModel}"> -->
            <!--                 <Button Margin="4" Command="{Binding LaunchCommand}"> -->
            <!--                     <Border Margin="4" Width="100" Height="100" CornerRadius="4"> -->
            <!--                         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"> -->
            <!--                             <Image Width="64" -->
            <!--                                    Source="{Binding IconPath, Converter={StaticResource FilePathToBitmapConverter}}" /> -->
            <!--                             <TextBlock TextAlignment="Center" Text="{Binding Name}" /> -->
            <!--                         </StackPanel> -->
            <!--                     </Border> -->
            <!--                     <Button.ContextMenu> -->
            <!--                         <ContextMenu> -->
            <!--                             <MenuItem -->
            <!--                                 i:MenuItem.Icon="mdi-pencil" Header="Edit Instance" -->
            <!--                                 Command="{Binding EditCommand}" -->
            <!--                                 CommandParameter="{Binding ElementName=MainGrid, Path=DataContext}" /> -->
            <!--                             <MenuItem -->
            <!--                                 i:MenuItem.Icon="mdi-trash-can" Header="Delete Instance" -->
            <!--                                 Command="{Binding DeleteCommand}" -->
            <!--                                 CommandParameter="{Binding ElementName=MainGrid, Path=DataContext}" /> -->
            <!--                         </ContextMenu> -->
            <!--                     </Button.ContextMenu> -->
            <!--                 </Button> -->
            <!--             </DataTemplate> -->
            <!--         </ItemsControl.ItemTemplate> -->
            <!--     </ItemsControl> -->
            <!-- </ScrollViewer> -->
        </Grid>
    </Panel>
</Window>